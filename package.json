{
  "name": "collaborative-math-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/build.mjs",
    "build:node": "node scripts/build.mjs node",
    "start:node": "node dist/standalone/server.js",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "scenarios:check": "node scripts/check-scenarios.mjs",
    "assets:generate": "node scripts/generate-map-symbol.mjs",
    "proofs:check": "node scripts/check-proofs.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write app lib db scripts tests scenarios .github *.ts *.mjs *.json *.md"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "mathlive": "0.110.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "milsymbol": "3.0.4",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "description": "An open-source student-owned collaborative algebra discovery lab.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pbrodd/collaborative-math-lab.git"
  }
}
