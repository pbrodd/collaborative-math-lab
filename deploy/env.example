# Copy to .env in the repository root.
# Generate a private setup key: openssl rand -hex 32
# Use it once in the setup screen to create the host account; then remove it here.
AUTH_SETUP_TOKEN=
# For the public deployment, use its actual HTTPS origin (no path).
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
# Bind only to the host by default; a host reverse proxy can reach this port.
BIND_ADDRESS=127.0.0.1
IMAGE_TAG=local
